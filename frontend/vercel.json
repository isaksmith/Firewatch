{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && cp -R ../sensors/viewer dist/nodes && rm -f dist/nodes/serve.py dist/nodes/start.ps1 dist/nodes/verify.mjs dist/nodes/README.md dist/nodes/.gitignore",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../sensors/viewer",
  "redirects": [{ "source": "/nodes", "destination": "/nodes/", "permanent": false }],
  "rewrites": [{ "source": "/((?!nodes/|assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/nodes/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
