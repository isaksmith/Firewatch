# sample = replay bundled Kansas fixtures offline; live = poll NASA FIRMS
MODE=sample

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (required for MODE=live)
FIRMS_MAP_KEY=

# Kansas: west,south,east,north
BBOX=-102.05,36.99,-94.59,40.00
POLL_MINUTES=5
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT

# auto = trained model (backend/data/model) when present, else rules; or force model | rules
SCORER=auto

THRESHOLD_ESCALATE=70
THRESHOLD_INVESTIGATE=40

# Optional: fix grass curing % instead of the seasonal default
# CURING_PCT_OVERRIDE=90

NWS_USER_AGENT=firewatch-hackathon (you@example.com)
