# sample = replay bundled Kansas fixtures offline; live = poll NASA FIRMS
MODE=sample

# Free key from https://firms.modaps.eosdis.nasa.gov/api/map_key/ (required for MODE=live)
FIRMS_MAP_KEY=

# Kansas: west,south,east,north
BBOX=-102.05,36.99,-94.59,40.00
POLL_FIRMS_S=60
FIRMS_SOURCES=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT,MODIS_NRT

# auto = trained model (backend/data/model) when present, else rules; or force model | rules
SCORER=auto

THRESHOLD_ESCALATE=70
THRESHOLD_INVESTIGATE=40

# Optional: fix grass curing % instead of the seasonal default
# CURING_PCT_OVERRIDE=90

NWS_USER_AGENT=firewatch-hackathon (you@example.com)

# Fire district: backend/data/districts/<slug>/ (boundary.geojson, roster.csv, settings.json)
DISTRICT=cottonwood-creek

# outbox = record texts without sending; twilio = send for real (sample events always use the outbox)
SMS_GATEWAY=outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Public URL of this server, used to verify Twilio webhook signatures
PUBLIC_BASE_URL=

# When set, required as X-Firewatch-Token on endpoints that can text people.
# Required in live mode: with this blank, replays, the board panel and the admin routes return 503.
API_TOKEN=
# The dashboard's Vite proxy adds this header itself, so it never reaches the browser.
# Never point a tunnel at Vite: the proxy adds the token for anyone who reaches it.

# Header carrying the real visitor IP behind the tunnel (cf-connecting-ip, or x-forwarded-for). Blank = use the socket peer.
# Honored only when the connection comes from loopback.
FORWARDED_IP_HEADER=

# Public board app: the only thing a tunnel may point at (port 8012). The main server must also run for timers and alerts.
#   uvicorn app.public_app:app --host 127.0.0.1 --port 8012

# Meshtastic radio attached to the server: off | serial | tcp. Mesh texts go out in sample mode too,
# but only to radios the roster's mesh_id column links to a contact.
MESH_GATEWAY=off
# Serial port (blank = first Meshtastic port found) or the radio's hostname for tcp
MESH_DEVICE=
MESH_CHANNEL_INDEX=0
# Copy every mesh text to the channel too, so the district's channel chat shows the whole incident.
MESH_CHANNEL_FEED=true

# OpenRouter (https://openrouter.ai/keys): plain-language answers to questions people text or radio in, and
# situation updates on the mesh channel while a paged fire is open. Blank = off. The alerts never use it.
OPENROUTER_API_KEY=
# openrouter/free picks a free model per request; a paid one (e.g. anthropic/claude-haiku-5.5) words more reliably
OPENROUTER_MODEL=openrouter/free
MESH_CHANNEL_UPDATES=true
CHANNEL_UPDATE_MIN=15
